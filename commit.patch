diff --git a/user/pingpong.c b/user/pingpong.c
new file mode 100644
index 0000000..13dd315
--- /dev/null
+++ b/user/pingpong.c
@@ -0,0 +1,39 @@
+#include "../kernel/types.h"
+#include "../user/user.h"
+
+int main(int argc, char *argv[])
+{
+    // partent -> child
+    int parent[2];
+    pipe(parent);
+    // child -> parent
+    int child[2];
+    pipe(child);
+
+    int byte;
+    // 先 pipe 再 fork
+    // fork() 会让子进程继承父进程当前打开的文件描述符
+    int pid = fork();
+
+    // pid == 0 表示子进程
+    if (pid == 0)
+    {
+        read(parent[0], &byte, sizeof(byte)); // 子进程读到一个字节
+        printf("%d: received ping from pid %d\n", getpid(), byte);
+        byte = getpid();
+        write(child[1], &byte, sizeof(byte));
+        close(parent[1]);
+        close(child[0]);
+        exit(0);
+    } else
+    {
+        byte = getpid();
+        write(parent[1], &byte, sizeof(byte));  // 父进程发送一个字节
+        read(child[0], &byte, sizeof(byte));
+        printf("%d: received pong from pid %d\n", getpid(),byte);
+        close(parent[0]);
+        close(child[1]);
+        wait(0);
+        exit(0);
+    }
+}
